# 외부 API 서버 주소. 비어있으면 앱은 mock 데이터로 동작합니다.
EXPO_PUBLIC_API_BASE_URL=

# 구글 로그인 (Google Cloud Console > OAuth 클라이언트 ID)
# webClientId: "웹 애플리케이션" 타입. idToken 발급에 필수. 백엔드 GOOGLE_CLIENT_IDS에도 같은 값을 넣는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iosClientId: "iOS" 타입. 백엔드 GOOGLE_CLIENT_IDS에도 넣는다.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS 클라이언트 ID를 뒤집은 URL 스킴 (app.config.ts에서 사용, 네이티브 빌드 시 필요)
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID
